# macOS packages for every Mac (install.sh runs `brew bundle` on this file).
# Language runtimes and neovim come from mise (~/.config/mise/config.toml),
# not from Homebrew. Hardware/embedded tools and build dependencies that only
# some Macs need are in Brewfile.extra.

# Shell and terminal
brew "bash"                # macOS ships bash 3.2; this is the login shell
brew "bash-completion@2"   # requires bash >= 4; conflicts with bash-completion (v1)
brew "tmux"
brew "screen"              # macOS ships screen 4.00.03 (2006); kept for serial consoles

# Dotfiles and tools
brew "chezmoi"
brew "mise"

# GNU tools. ~/.profile.d/10-homebrew.sh puts gnu-sed, gawk, make and e2fsprogs
# ahead of the macOS tools on PATH; coreutils and gnu-tar stay g-prefixed
# (gls, gdate, gtar, ...) so that macOS scripts keep the BSD versions.
brew "coreutils"
brew "gnu-sed"
brew "gnu-tar"
brew "gawk"
brew "make"
brew "binutils"            # appended to PATH, so the macOS toolchain still wins
brew "e2fsprogs"

# CLI
brew "git"
brew "git-lfs"
brew "git-filter-repo"
brew "gh"
brew "peco"                # ghq comes from mise on every platform
brew "fzf"
brew "ripgrep"
brew "fd"
brew "jq"
brew "yq"
brew "tree"
brew "pstree"
brew "wget"
brew "telnet"
brew "vim"
brew "openssl"
brew "pkg-config"
brew "pandoc"
brew "graphviz"

# Development
brew "go-task"
brew "uv"
brew "ipython"
brew "hf"                  # Hugging Face hub CLI
brew "mysql-client@8.0"    # put on PATH by ~/.profile.d/10-homebrew.sh

# Cloud and containers
brew "awscli"
brew "kubernetes-cli"
brew "k3d"
brew "cloudflared"

# GPG commit signing
brew "gnupg"
brew "pinentry-mac"

# Apps. Docker Desktop is not here: it updates itself, and a cask on top of
# that drifts out of sync. Install it from docker.com (scripts/platform.sh warns
# when it is missing).
cask "bitwarden"
cask "discord"
cask "evernote"
cask "figma"
cask "google-chrome"
cask "postman"
cask "slack"
cask "spotify"
cask "visual-studio-code"
cask "vivaldi"
cask "wireshark-app"
cask "zoom"
